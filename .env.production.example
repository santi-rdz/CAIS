IMAGE_TAG=v0.0.1
# BUILD_PLATFORM=linux/amd64   # ARM → linux/arm64

# App
# Usuario/password deben coincidir con MYSQL_USER/MYSQL_PASSWORD de abajo.
DATABASE_URL=mysql://user:CAMBIA_ESTO@db:3306/cais
FRONTEND_URL=http://localhost:8080
VITE_API_URL=/api               # nginx proxea /api → backend, no tocar
SESSION_SECRET=CAMBIA_ESTO      # openssl rand -hex 32
# SESSION_COOKIE_SECURE=false   # solo para pruebas HTTP

# Puerto publicado (solo el frontend/nginx; el backend queda interno tras /api)
FRONTEND_PORT=8080

# MySQL
MYSQL_ROOT_PASSWORD=CAMBIA_ESTO_root
MYSQL_DATABASE=cais
MYSQL_USER=user
MYSQL_PASSWORD=CAMBIA_ESTO

# SMTP
EMAIL_USER=
EMAIL_PASS=

# Admin inicial (bootstrap). Se crea una sola vez en el primer arranque; si el
# correo ya existe no se toca. Usa un password fuerte (openssl rand -base64 18).
ADMIN_EMAIL=admin@cais.uabc.mx
ADMIN_PASSWORD=CAMBIA_ESTO
ADMIN_NOMBRE=Admin
ADMIN_APELLIDOS=CAIS
